{
  "connectors": [
    {
      "id": "github",
      "name": "GitHub REST API",
      "type": "api",
      "base_url": "https://api.github.com",
      "timeout": 30,
      "retries": 2,
      "auth": { "type": "bearer", "token_env": "GITHUB_TOKEN" },
      "headers": { "Accept": "application/vnd.github+json", "X-GitHub-Api-Version": "2022-11-28" },
      "endpoints": {
        "get_user": {
          "description": "Fetch a GitHub user's public profile",
          "method": "GET",
          "path": "/users/{username}",
          "params": ["username"]
        },
        "list_repos": {
          "description": "List repositories for a GitHub user",
          "method": "GET",
          "path": "/users/{username}/repos",
          "params": ["username", "per_page"]
        }
      }
    },
    {
      "id": "filesystem",
      "name": "Filesystem MCP server",
      "type": "mcp",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
    }
  ]
}